# Defect classes only, the same set as flux. Each disabled check below was run over the flux tree
# and every hit was a false positive or intended.
# Only cyra's own headers: the vendored nanobind under thirdparty/ is not ours to change.
HeaderFilterRegex: '.*/cyra_[a-z]+/include/.*'
Checks: >
  -*,
  bugprone-*,
  concurrency-*,
  performance-*,
  -bugprone-easily-swappable-parameters,
  -bugprone-narrowing-conversions,
  -bugprone-branch-clone,
  -bugprone-switch-missing-default-case,
  -bugprone-empty-catch,
  -bugprone-unchecked-optional-access,
  -bugprone-unchecked-string-to-number-conversion,
  -bugprone-return-const-ref-from-parameter,
  -concurrency-mt-unsafe,
  -performance-no-int-to-ptr,
  -performance-enum-size,
  -performance-inefficient-string-concatenation
CheckOptions:
  performance-unnecessary-value-param.AllowedTypes: '^::nanobind::'
